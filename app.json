{
  "expo": {
    "name": "GathaLok",
    "slug": "gathalok-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1E2D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "gathalok",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gathalok.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#0B1E2D"
      },
      "package": "com.gathalok.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1E2D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 192,
          "resizeMode": "contain",
          "ios": {
            "image": "./assets/splash.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GathaLok to access your photos to set an avatar or add a story cover image."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "482bf7f6-e024-4ded-932f-e3e4c8094273"
      }
    },
    "owner": "prahladsingh7512s-team"
  }
}
