{
  "expo": {
    "name": "GathaLok",
    "slug": "gathalok-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1E2D"
    },
    "assetBundlePatterns": ["**/*"],
    "scheme": "gathalok",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gathalok.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1E2D"
      },
      "package": "com.gathalok.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
